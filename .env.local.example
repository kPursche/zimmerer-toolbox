# Supabase (vorbereitet für PROJ-2 Auth — in PROJ-1 noch nicht aktiviert)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-Role-Key — NUR serverseitig, NIEMALS mit NEXT_PUBLIC_-Präfix!
# Nötig für Community-Schreib-/Löschzugriffe (RLS sperrt anon-Schreiben).
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ntfy.sh Push-Benachrichtigungen für Feedback
# Wähle einen langen, schwer erratbaren Topic-Namen
NTFY_TOPIC=zimmerer-feedback-DEIN-GEHEIMES-TOPIC

# OpenAI API — für Whisper Sprach-Transkription im Community-Chat
OPENAI_API_KEY=sk-...

# ElevenLabs — Sprachausgabe (TTS) in der Latteneinteilung
ELEVENLABS_API_KEY=your-elevenlabs-key
# Optional: eigene Voice-ID (Standard ist in tts/route.ts hinterlegt)
# ELEVENLABS_VOICE_ID=...
